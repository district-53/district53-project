# -*- mode: ruby -*-
# vi: set ft=ruby :

BASE_NODES = [
  { name: "db",     ip: "192.168.56.11", mem: 1024, cpus: 1, box: "district53/db" },
  { name: "jenkins", ip: "192.168.56.12", mem: 2048, cpus: 2, box: "district53/jenkins" },
  { name: "consul", ip: "192.168.56.20", mem: 1024, cpus: 1, box: "district53/base" },
]

APP_COUNT = 2
APP_NODES = (1..APP_COUNT).map do |i|
  { name: "app#{i}", ip: "192.168.56.#{12 + i}", mem: 1024, cpus: 1, db_client: true, init_db: i == 1, box: "district53/app" } 
end

LB_NODE = { name: "lb", ip: "192.168.56.10", mem: 1024, cpus: 1, box: "district53/lb" }

NODES = BASE_NODES + APP_NODES + [LB_NODE]


Vagrant.configure("2") do |config|
    config.vm.box_check_update = false
    config.vm.synced_folder ".", "/vagrant", disabled: true

    NODES.each do |n|
        config.vm.define n[:name] do |node|
            node.vm.box = n[:box] 
            node.vm.hostname = n[:name]
            node.vm.network "private_network", ip: n[:ip]
      
            node.vm.provider "virtualbox" do |vb|
            vb.memory = n[:mem]
            vb.cpus   = n.fetch(:cpus, 1)
            end
        end
    end
end