jenkins:
  systemMessage: "Jenkins is configured by Ansible"
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: "admin"
          password: "{{ jenkins_admin_password }}"
  nodes:
    - permanent:
        name: "host"
        labelString: "host"
        remoteFS: "{{ jenkins_agent_dir }}"
        numExecutors: 1
        launcher:
          inbound:
            webSocket: true
        retentionStrategy: "always"
  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false

credentials:
  system:
    domainCredentials:
      - credentials:
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "ansible-ssh-key"
              username: "ansible"
              description: "Ansible SSH key"
              privateKeySource:
                directEntry:
                  privateKey: "${readFile:/var/lib/jenkins/casc_secrets/ansible_key}"

jobs:
  - script: |
      ['packer', 'infra', 'config'].each { name ->
        pipelineJob(name) {
          definition {
            cpsScm {
              scm {
                git {
                  remote { url('{{ jenkins_repo_url }}') }
                  branch('*/{{ jenkins_pipelines_branch }}')
                }
              }
              scriptPath('infra/jenkins/pipelines/' + name + '.Jenkinsfile')
            }
          }
        }
      }