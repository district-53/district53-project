# -*- mode: ruby -*-
# vi: set ft=ruby :

NODES = [
  { name: "lb",     ip: "192.168.56.10", box: "district53/lb",   mem: 1024, cpus: 1 },
  { name: "db",     ip: "192.168.56.11", box: "district53/db",   mem: 2048, cpus: 2 },
  { name: "consul", ip: "192.168.56.12", box: "district53/base", mem: 1024, cpus: 1 },
  { name: "app1",   ip: "192.168.56.13", box: "district53/app",  mem: 1024, cpus: 1 },
  { name: "app2",   ip: "192.168.56.14", box: "district53/app",  mem: 1024, cpus: 1 },
]

Vagrant.configure("2") do |config|
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  NODES.each do |n|
    config.vm.define n[:name] do |node|
      node.vm.box      = n[:box]
      node.vm.hostname = n[:name]
      node.vm.network "private_network", ip: n[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name         = "d53-#{n[:name]}"
        vb.memory       = n[:mem]
        vb.cpus         = n[:cpus]
        vb.linked_clone = true
      end
    end
  end
end