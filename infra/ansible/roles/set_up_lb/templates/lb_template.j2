log_format upstreamlog '$remote_addr -> $upstream_addr [$time_local] ' '"$request" $status rt=$request_time urt=$upstream_response_time';


upstream app_backend {
{% if lb_strategy == 'least_conn' %}
    least_conn;
{% elif lb_strategy == 'ip_hash' %}
    ip_hash;
{% elif lb_strategy == 'round_robin' %}
    # round_robin
{% else %}
{{ fail("ERROR: unknown lb_strategy")}}
{% endif %}

{% for host in groups['apps']%}
    server {{ host }}:{{ app_port}} max_fails=3 fail_timeout=10s;
{% endfor %}
    keepalive 32;
}


server {
    listen 80 default_server;
    server_name _;
    client_max_body_size 6m;

    access_log /var/log/nginx/lb_access.log upstreamlog;
    error_log  /var/log/nginx/lb_error.log warn;

    location / {
        proxy_pass http://app_backend;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 3s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }

    location = /nginx_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
    }
}
